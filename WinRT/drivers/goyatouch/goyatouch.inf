; Zinitix BT532 touchscreen (Galaxy Tab 3 Lite) - WDM HID minidriver, reports as a HID absolute mouse
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%PROVIDER%
DriverVer = 11/21/2026,1.1.0.0
CatalogFile=goyatouch.cat

[SourceDisksNames]
3426=windows cd

[SourceDisksFiles]
goyatouch.sys = 3426

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%PROVIDER%=Goya,NTARM

[Goya.NTARM]
%Touch.DeviceDesc% = Touch_Inst,ACPI\MRVL0005

[Touch_Inst.NT]
CopyFiles = Touch_Copy

[Touch_Copy]
goyatouch.sys

[Touch_Inst.NT.Services]
AddService = goyatouch,0x00000002,Touch_Service_Inst

[Touch_Service_Inst]
DisplayName    = %Touch.SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\goyatouch.sys

[Strings]
PROVIDER = "Goya"
Touch.DeviceDesc = "Zinitix BT532 Touchscreen (HID mouse)"
Touch.SvcDesc = "Zinitix BT532 Touchscreen"
